# Supabase Configuration (Required)
# Get these values from your Supabase project dashboard → Settings → API
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_STAGING_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
REACT_APP_SUPABASE_STAGING_ANON_KEY=****.your_anon_key_here
SUPABASE_ACCESS_TOKEN=***
PGPASSWORD=***

# Application Configuration
# Allowed values: debug, production
REACT_APP_ENVIRONMENT=debug

# AI Assistant Configuration
# CRA exposes REACT_APP_* values in the browser bundle.
REACT_APP_OAI_API_KEY=your_dashscope_api_key_here
REACT_APP_OAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Edge Function secrets use these variable names but need a separate provider key.
# Do not reuse the browser key: CRA embeds REACT_APP_* values in its bundle.
OAI_MODEL=qwen3.5-flash
TRANSFER_ASSESSMENT_ENABLED=true

# Development Configuration (Optional)
# REACT_APP_DEBUG_MODE=true
# REACT_APP_LOG_LEVEL=info
